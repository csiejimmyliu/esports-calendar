  "error_response_samples": {
    "unknown_tournament_slug_on_matches_endpoint": {
      "request": "GET https://api.blast.tv/v2/games/cs/tournaments/NOT-A-REAL-TOURNAMENT-ID-xyz/matches",
      "status": 200,
      "body": "[]",
      "note": "No distinction between 'tournament does not exist' and 'tournament exists but has zero matches' (e.g. EWC 2026 also returns [] before its bracket matches are scheduled). Both cases are silent empty arrays, not errors."
    },
    "unknown_sub_route": {
      "request": "GET https://api.blast.tv/v2/games/cs/tournaments/bounty-2026-season-2/matches/not-a-real-match-id",
      "status": 404,
      "body": { "code": "not-found", "message": "Route GET:/v2/games/cs/tournaments/bounty-2026-season-2/matches/not-a-real-match-id not found" },
      "note": "This is Fastify's default 404 envelope (routing-level 404, not an application-level 'match not found' error) — there is no dedicated single-match-by-id route; the frontend always fetches the full /matches or /brackets list and finds the match client-side."
    },
