{
  "name": "esports-calendar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "lint": "eslint .",
    "serve": "tsx src/api/server.ts",
    "capture": "tsx scripts/capture-fixture.ts",
    "capture:check": "tsx scripts/capture-check.ts",
    "capture:refresh": "tsx scripts/capture-refresh.ts",
    "probe": "tsx scripts/probe-api.ts",
    "migrate": "tsx src/db/migrate.ts",
    "sync": "tsx src/cli/sync.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^3.23.0"
  }
}
